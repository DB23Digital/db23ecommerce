# DB23 eCommerce — Apache configuration
# Handles SPA routing, HTTPS enforcement, security headers, caching, and compression.

Options -MultiViews
RewriteEngine On

# ── 1. Force HTTPS (must come before SPA routing) ──────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. SPA routing — serve existing files/dirs directly ────────────────────
DirectoryIndex index.php index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Return real 404 for paths that don't exist AND aren't SPA routes.
# React Router handles client-side 404s; this ensures unknown paths
# served after JS loads still emit the correct HTTP status.
ErrorDocument 404 /index.php

# ── 3. Security headers ────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — tell browsers to always use HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Control referrer information sent to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict browser feature access
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Content Security Policy
    # Adjust script-src if you add new third-party scripts
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; frame-src https://storage.googleapis.com;"
</IfModule>

# ── 4. Cache static assets with far-future expiry ─────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg        "access plus 1 year"
    ExpiresByType image/jpeg       "access plus 1 year"
    ExpiresByType image/gif        "access plus 1 year"
    ExpiresByType image/png        "access plus 1 year"
    ExpiresByType image/svg+xml    "access plus 1 year"
    ExpiresByType image/webp       "access plus 1 year"
    ExpiresByType image/x-icon     "access plus 1 year"
    ExpiresByType text/css         "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html        "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Immutable cache for hashed Vite assets (e.g. index-BAdN6n5Z.js)
    <FilesMatch "\.(js|css)$">
        Header append Cache-Control "public, immutable"
    </FilesMatch>
    # No-cache for HTML (PHP handles per-request)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ── 5. Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml
</IfModule>
